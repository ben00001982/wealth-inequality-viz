node_modules/
dist/
dist-local/
dist-single/
*.local
.DS_Store
.vite/

# Raw source data is deliberately not committed. The files are large, their licences are per-source,
# and the acquisition manifest records exactly what to download and where to put it. Committing them
# would also risk shipping a dataset under terms that do not permit redistribution.
data/raw/
data/processed/

# Generated front-end data is not committed either. It is either synthetic placeholder output from
# scripts/make_synthetic.py, which is regenerable in one command, or real pipeline output, which
# should be published deliberately rather than drifting into the repository by accident. Keeping it
# out also removes any chance of a committed placeholder being mistaken for pipeline output.
# The deploy workflow generates placeholders when the directory is empty, so a fresh clone still
# builds. Run `npm run data` locally before `npm run dev`.
public/data/*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Single-file offline builds. Regenerable with `npm run build:single`, and 1.4 MB each, so they are
# delivered rather than committed.
/wealth-viz-prototype-*.html

# Playwright smoke test artefacts
/smoke.mjs
/smoke-single.mjs
/dbg.mjs
/shots.mjs
/test-results/
